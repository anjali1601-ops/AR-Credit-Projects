# Copy to .env and edit. Every value below already has a working offline default,
# so the app runs end to end without setting any of them.

# --- LLM -------------------------------------------------------------------
# mock (default, deterministic, no network) | openai | anthropic
DRA_LLM_PROVIDER=mock
# DRA_OPENAI_API_KEY=sk-...
# DRA_OPENAI_MODEL=gpt-4o-mini
# DRA_ANTHROPIC_API_KEY=sk-ant-...
# DRA_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Database --------------------------------------------------------------
# Default is a local SQLite file under ./var/. Point at PostgreSQL to switch:
# DRA_DATABASE_URL=postgresql+psycopg://dra:dra@localhost:5432/dra
# Optional dedicated read-only role for the Text-to-SQL path:
# DRA_READONLY_DATABASE_URL=postgresql+psycopg://dra_ro:dra_ro@localhost:5432/dra

# --- Vector store ----------------------------------------------------------
# chroma (default, persistent local ChromaDB) | memory
DRA_VECTOR_STORE=chroma

# --- Service ---------------------------------------------------------------
DRA_API_HOST=127.0.0.1
DRA_API_PORT=47821
# Reactive inbox poller: the service picks up new mail on its own.
DRA_INBOX_POLL_ENABLED=true
DRA_INBOX_POLL_INTERVAL_SECONDS=3
# Credit memos at or below this amount are auto-approved; above it a supervisor
# must click approve. Set to 0 to always require a human.
DRA_AUTO_APPROVE_LIMIT=0
