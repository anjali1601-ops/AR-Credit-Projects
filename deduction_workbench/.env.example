# Narrative only. Classification, policy, and routing never call a model.
# offline (default) writes a deterministic clerk note from the decision.
DEDUCTION_LLM_PROVIDER=offline

# Set the provider to openai and supply a key to rewrite that note with a hosted model.
# The queue, the outcome, and the citation still come from the deterministic checks.
# DEDUCTION_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# DEDUCTION_DB_PATH=
