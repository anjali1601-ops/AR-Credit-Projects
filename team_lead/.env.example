# Narrative provider. Ratings and flight-risk flags stay in code either way.
TEAM_LEAD_LLM_PROVIDER=offline

# Set the provider to openai to draft prose with a hosted model.
# TEAM_LEAD_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# TEAM_LEAD_LLM_MODEL=gpt-4o-mini

# SQLite file. Defaults to ./data/cockpit.db from the working directory.
# TEAM_LEAD_DB=
