# Default. Matching never calls a model. The explainer fills a fixed template.
CASH_APP_LLM_PROVIDER=offline

# Uncomment to have a hosted model write the clerk-facing explanation only.
# Amounts, invoice picks, and the recommended action stay in deterministic code.
# CASH_APP_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional override. Defaults to cash_application/data/ar.sqlite
# CASH_APP_DB=
